# Supabase Dashboard > Connect > Session pooler (IPv4) or Direct connection (IPv6).
DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Production employee-document storage. Create this as a private bucket and never expose the service key to the frontend.
DOCUMENT_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_DOCUMENT_BUCKET=employee-documents

# Optional local PostgreSQL fallback used only by Docker Compose.
LOCAL_DB_NAME=multitenant_erp
LOCAL_DB_USERNAME=erp
LOCAL_DB_PASSWORD=replace_with_a_secure_local_password
LOCAL_DB_PORT=5432
VITE_API_BASE_URL=http://localhost:8080/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
